+# Prefer a local Unitree SDK2 copy inside RoboJuDo, then fall back to system paths.
+set(UNITREE_ARCH_DIR "${CMAKE_SYSTEM_PROCESSOR}")
+set(UNITREE_SDK2_LOCAL_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/../../third_party/unitree_sdk2")
+
+set(UNITREE_SDK2_LIB_PATHS /usr/local/lib /usr/lib)
+set(UNITREE_SDK2_INCLUDE_PATHS /usr/local/include /usr/include)
+set(DDS_LIB_PATHS /usr/local/lib /usr/lib)
+set(DDS_INCLUDE_PATHS /usr/local/include/ddscxx /usr/include)
+set(DDS_C_INCLUDE_PATHS /usr/local/include /usr/include)
+
+if(EXISTS "${UNITREE_SDK2_LOCAL_ROOT}/include" AND EXISTS "${UNITREE_SDK2_LOCAL_ROOT}/lib/${UNITREE_ARCH_DIR}")
+  message(STATUS "Using local unitree_sdk2 from: ${UNITREE_SDK2_LOCAL_ROOT}")
+  list(PREPEND UNITREE_SDK2_LIB_PATHS "${UNITREE_SDK2_LOCAL_ROOT}/lib/${UNITREE_ARCH_DIR}")
+  list(PREPEND UNITREE_SDK2_INCLUDE_PATHS "${UNITREE_SDK2_LOCAL_ROOT}/include")
+  list(PREPEND DDS_LIB_PATHS "${UNITREE_SDK2_LOCAL_ROOT}/thirdparty/lib/${UNITREE_ARCH_DIR}")
+  list(PREPEND DDS_INCLUDE_PATHS "${UNITREE_SDK2_LOCAL_ROOT}/thirdparty/include/ddscxx")
+  list(PREPEND DDS_C_INCLUDE_PATHS "${UNITREE_SDK2_LOCAL_ROOT}/thirdparty/include")
+endif()
+
+find_library(UNITREE_SDK2_LIB NAMES unitree_sdk2 PATHS ${UNITREE_SDK2_LIB_PATHS})
+find_path(UNITREE_SDK2_INCLUDE NAMES unitree/robot/channel/channel_factory.hpp PATHS ${UNITREE_SDK2_INCLUDE_PATHS})
 
-find_library(DDSC_LIB NAMES ddsc PATHS /usr/local/lib /usr/lib)
-find_library(DDSCXX_LIB NAMES ddscxx PATHS /usr/local/lib /usr/lib)
-find_path(DDSCXX_ROOT_INCLUDE dds/dds.hpp PATHS /usr/local/include/ddscxx /usr/include)
+find_library(DDSC_LIB NAMES ddsc PATHS ${DDS_LIB_PATHS})
+find_library(DDSCXX_LIB NAMES ddscxx PATHS ${DDS_LIB_PATHS})
+find_path(DDSCXX_ROOT_INCLUDE dds/dds.hpp PATHS ${DDS_INCLUDE_PATHS})
 
 if(NOT UNITREE_SDK2_LIB OR NOT UNITREE_SDK2_INCLUDE)
   message(FATAL_ERROR "Cannot find installed unitree_sdk2 library or headers in /usr/local")
@@ -33,6 +52,21 @@ message(STATUS "Found ddsc lib: ${DDSC_LIB}")
