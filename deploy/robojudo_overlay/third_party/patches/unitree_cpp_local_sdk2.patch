+set(UNITREE_RUNTIME_RPATH /usr/local/lib)
+if(UNITREE_SDK2_LIB)
+  get_filename_component(UNITREE_SDK2_LIB_DIR "${UNITREE_SDK2_LIB}" DIRECTORY)
+  list(PREPEND UNITREE_RUNTIME_RPATH "${UNITREE_SDK2_LIB_DIR}")
+endif()
+if(DDSC_LIB)
+  get_filename_component(DDSC_LIB_DIR "${DDSC_LIB}" DIRECTORY)
+  list(PREPEND UNITREE_RUNTIME_RPATH "${DDSC_LIB_DIR}")
+endif()
+if(DDSCXX_LIB)
+  get_filename_component(DDSCXX_LIB_DIR "${DDSCXX_LIB}" DIRECTORY)
+  list(PREPEND UNITREE_RUNTIME_RPATH "${DDSCXX_LIB_DIR}")
+endif()
+list(REMOVE_DUPLICATES UNITREE_RUNTIME_RPATH)
+
